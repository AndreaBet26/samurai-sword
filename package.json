{
  "name": "samurai-sword",
  "version": "1.0.0",
  "description": "Digital version of the tabletop game Samurai Sword",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx server/src/index.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client --port 5173",
    "dev": "node scripts/dev.js",
    "build": "vite build client",
    "test": "node scripts/test.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
